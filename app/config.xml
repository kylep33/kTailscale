<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.kylep33.ktailscale" version="0.0.2" viewmodes="application"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">
  <name xml:lang="en">kTailscale</name>
  <description xml:lang="en">Tailscale for Kindle</description>
  <content src="index.html" />
  <feature name="http://kindle.amazon.com/apis" required="true">
    <param name="chrome" value="yes" />
    <param name="appmgr" value="yes" />
    <param name="messaging" value="yes" />
  </feature>
  <kindle:messaging>
    <kindle:app name="com.kindlemodding.utild" value="yes" />
  </kindle:messaging>
</widget>
